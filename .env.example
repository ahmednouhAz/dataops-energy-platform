# Copy this file to .env (gitignored) and fill in real values. Nothing here
# is a real secret -- these are the placeholder defaults for a local dev
# stack, not production credentials. See docs/adr/0005-docker-compose.md.

# MinIO (object storage) root credentials. Used by the minio service itself
# and by the minio-setup job that creates the DVC bucket. MinIO requires
# the password to be at least 8 characters.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-locally

# Where the worker container's dlt/dbt commands read and write the
# warehouse file. /app is the repo, bind-mounted into the worker service --
# same file the host sees as ./dev.duckdb.
DUCKDB_PATH=/app/dev.duckdb

# Reachable only from inside the Docker network (service name as host).
# No flows run against this yet -- wired up for real in step 12.
PREFECT_API_URL=http://prefect-server:4200/api
